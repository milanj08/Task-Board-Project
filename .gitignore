# OS / editor junk
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Editor/tool config tied to this machine — the paths inside point at a local
# home directory, so it's useless to anyone else cloning. Same reasoning as
# .idea/ and .vscode/ above.
.claude/

# Safety net: never commit environment files or dependencies at the repo root.
# (web/ has its own .gitignore covering node_modules, dist, and *.local.)
.env
.env.*
!.env.example
node_modules/

# Private working files kept in this folder but never published — reference
# documents and personal notes. Code and project docs are committed; these
# working files are not.
*.pdf
*.docx
video_talking_points.md

# Stray empty lockfile created at the repo root by accident (safe to delete).
/package-lock.json
