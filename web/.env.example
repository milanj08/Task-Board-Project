# Copy this file to .env.local and fill in your Supabase project values.
# .env.local is gitignored and never committed.

# Project URL — Supabase dashboard > Project Settings > Data API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (public) key — safe for the frontend; RLS protects your data.
# NEVER put the service_role key here or anywhere in the frontend/git.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
